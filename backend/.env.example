# ─────────────────────────────────────────────────────────────
# KaushAI Backend — Environment Configuration
# Copy to `.env` and fill in. NEVER commit the real `.env`.
# ─────────────────────────────────────────────────────────────

# App
KAUSHAI_ENV=development                # development | staging | production
KAUSHAI_DEBUG=true
KAUSHAI_API_PREFIX=/api/v1
KAUSHAI_PROJECT_NAME=KaushAI
KAUSHAI_LOG_LEVEL=INFO

# Server
HOST=0.0.0.0
PORT=8000

# Database
# Local dev falls back to SQLite automatically if unset.
# Production (Supabase): postgresql+psycopg2://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
DATABASE_URL=

# Security
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production-please-use-a-long-random-value
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14
JWT_ALGORITHM=HS256

# CORS — comma separated origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Supabase (optional — used for Supabase Auth + Storage integration)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_STORAGE_BUCKET=kaushai-media

# Redis (optional — caching / rate-limit / websocket fan-out). Falls back to in-memory.
REDIS_URL=

# AI Providers — abstraction layer. Leave blank to use the built-in MOCK providers.
AI_STT_PROVIDER=mock                   # mock | openai | bhashini | google
AI_LLM_PROVIDER=mock                   # mock | openai | anthropic
AI_TTS_PROVIDER=mock                   # mock | openai | bhashini
AI_TRANSLATE_PROVIDER=mock             # mock | bhashini | google

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
BHASHINI_API_KEY=
BHASHINI_USER_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# Recommendation engine — path to a JSON weights override (optional)
RECOMMENDATION_WEIGHTS_FILE=

# Seed
SEED_ADMIN_EMAIL=admin@kaushai.gov.in
SEED_ADMIN_PASSWORD=KaushAI@2026
