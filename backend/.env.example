# ─────────────────────────────────────────────────────────────
# Kaushal AI Backend — Environment Configuration
# Copy to `.env` and fill in. NEVER commit the real `.env`.
# ─────────────────────────────────────────────────────────────

# App
KAUSHAI_ENV=development                # development | staging | production
KAUSHAI_DEBUG=true
KAUSHAI_API_PREFIX=/api/v1
KAUSHAI_PROJECT_NAME=Kaushal AI
KAUSHAI_LOG_LEVEL=INFO

# Server
HOST=0.0.0.0
PORT=8000

# Database
# Local dev falls back to SQLite automatically if unset.
# Production (Supabase): postgresql+psycopg2://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
DATABASE_URL=

# Security
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production-please-use-a-long-random-value
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14
JWT_ALGORITHM=HS256

# CORS — comma separated origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Supabase (optional — used for Supabase Auth + Storage integration)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_STORAGE_BUCKET=kaushai-media

# Redis (optional — caching / rate-limit / websocket fan-out). Falls back to in-memory.
REDIS_URL=

# AI Providers — abstraction layer. Leave blank to use the built-in MOCK providers.
AI_STT_PROVIDER=mock                   # mock | openai
AI_LLM_PROVIDER=groq                   # mock | groq | openai
AI_TTS_PROVIDER=mock                   # mock | openai
AI_TRANSLATE_PROVIDER=mock             # mock | openai
# NOTE: the Android app's UI text is NOT translated through a provider — every
# string ships compiled into the APK (app/src/main/.../ui/i18n/Strings.kt) so the
# interface renders instantly and identically offline. AI_TRANSLATE_PROVIDER only
# backs the /translate endpoint.

# Groq powers the AI interviewer and the assistant chat (the one provider here
# that streams, which is what makes answers type themselves out in the app).
# Check what your key can serve:  curl -H "Authorization: Bearer $GROQ_API_KEY" \
#   https://api.groq.com/openai/v1/models
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_SECONDS=45

OPENAI_API_KEY=
SARVAM_API_KEY=
BHASHINI_API_KEY=
BHASHINI_USER_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# Recommendation engine — path to a JSON weights override (optional)
RECOMMENDATION_WEIGHTS_FILE=

# Mobile app auth — name + phone + password, verified by SMS code.
OTP_TTL_MINUTES=10

# SMS gateway. "console" logs the code instead of sending it, and is the only
# mode in which the API echoes the code back in the response so a demo works
# with no credentials. Set SMS_PROVIDER=twilio and the echo stops on its own —
# there is no separate flag to remember to turn off.
SMS_PROVIDER=console                   # console | twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Seed
SEED_ADMIN_EMAIL=admin@kaushai.gov.in
SEED_ADMIN_PASSWORD=Admin@2026
